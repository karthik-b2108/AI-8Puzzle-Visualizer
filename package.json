{
  "name": "dfs-8puzzle",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "An interactive depth-first search visualizer for the 8-puzzle.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "node scripts/gen-fixtures.mjs"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "d3-hierarchy": "^3.1.2",
    "framer-motion": "^14.4.0",
    "lucide-react": "^1.60.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "react-window": "^2.4.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
